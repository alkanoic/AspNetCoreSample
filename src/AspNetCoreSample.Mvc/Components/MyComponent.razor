@page "/mycomponent"
@inject IHttpClientFactory HttpClientFactory
@using System.Text.Json

<h3>Hello from MyComponent</h3>

@if (data == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Summary: @data.Summary</p>
    <p>Temperature: @data.TemperatureC</p>
    <button @onclick="UpdateData">Update</button>
}

@code {
    public const string HttpClientName = "WebApi";

    private WeatherForecast? data;

    protected override async Task OnInitializedAsync()
    {
        await UpdateData();
    }

    private async Task UpdateData()
    {
        try
        {
            var client = HttpClientFactory.CreateClient(HttpClientName);
            string jsonString = await client.GetStringAsync("WeatherForecast");
            var options = new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                };
            var d = JsonSerializer.Deserialize<WeatherForecast[]>(jsonString, options);
            if (d is not null && d.Length != 0)
                data = d[0];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"WeatherForecast API call failed: {ex.Message}");
        }
    }

    public class WeatherForecast
    {
        public DateTime Date { get; set; }

        public int TemperatureC { get; set; }

        public string? Summary { get; set; }
    }
}
