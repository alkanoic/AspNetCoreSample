{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "env": [
        "OLLAMA_API_KEY"
      ],
      "options": {
        "baseURL": "https://ollama.com/v1"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B"
        },
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B"
        },
        "qwen3-coder:480b": {
          "name": "Qwen3 Coder 480B"
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "cwd": ".",
      "enabled": true
    }
  }
}